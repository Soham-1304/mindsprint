# ==============================================================================
# Patch-Up SRE Agent + Sietch Control Plane — Environment Configuration
# Copy to .env and fill in secrets before running locally or in Docker/Render.
# ==============================================================================

# --- Server & Dashboard ---
PORT=5050
DASHBOARD_PUBLIC_URL=http://localhost:5174
MONITORING_MODE=push-ephemeral
SQLITE_DB_PATH=/tmp/patchup.sqlite

# --- Push-On-Break Webhook (Configure on target apps like PulseShop) ---
PATCHUP_WEBHOOK_URL=http://localhost:5050

# --- Primary LLM: Gemini 3.5 Flash-Lite ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Secondary Backup LLM: Groq (OpenAI-compatible fast inference) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- GitHub App (Multi-Tenant Vercel-Style Onboarding) & PR Bot ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=patch-up
GITHUB_APP_PRIVATE_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_OWNER=Soham-1304
GITHUB_REPO=pulseshop

# --- Live PulseShop Microservices (Vercel Deployments) ---
GATEWAY_URL=https://pulseshop-gateway.vercel.app
ORDERS_URL=https://pulseshop-orders.vercel.app
PAYMENTS_URL=https://pulseshop-payments.vercel.app

# --- Operator 1-Tap Approval Security (ASK_FIRST Gate) ---
OPERATOR_APPROVAL_TOKEN=patchup-operator-2026

# --- Pluggable Alerting Channels (Optional) ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
NTFY_TOPIC_URL=
PAGERDUTY_ROUTING_KEY=

# --- Sietch Kiroween Dist Path (Defaults to ../../../../Kiroween locally; set to /app/backend/vendor/sietch in Docker) ---
# SIETCH_KIROWEEN_DIR=/app/backend/vendor/sietch
