{
  "name": "@sietch/core",
  "version": "0.0.0",
  "private": true,
  "description": "Sietch core: event model, rules engine, and verdict logic. Pure TypeScript with no I/O.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
