{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@sietch/core": [
        "./vendor/sietch/base/core/dist/index.d.ts",
        "../../../Kiroween/base/core/dist/index.d.ts"
      ],
      "@sietch/sandbox": [
        "./vendor/sietch/base/sandbox/dist/index.d.ts",
        "../../../Kiroween/base/sandbox/dist/index.d.ts"
      ]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
